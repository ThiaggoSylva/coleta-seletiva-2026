{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ColetaSeletiva": ""
  },
  "Jwt": {
    "Issuer": "coleta-seletiva-api",
    "Audience": "coleta-seletiva-web",
    "SigningKey": ""
  },
  "Sessao": {
    "AccessTokenMinutos": 15,
    "RefreshTokenDias": 7,
    "OrigemPermitida": ""
  },
  "LimitesDeTaxa": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Cadastro": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  }
}
