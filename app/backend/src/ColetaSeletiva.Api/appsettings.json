{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AplicarMigrationsNoInicio": false
  },
  "ConnectionStrings": {
    "ColetaSeletiva": ""
  },
  "Jwt": {
    "Issuer": "coleta-seletiva-api",
    "Audience": "coleta-seletiva-web",
    "SigningKey": ""
  },
  "Sessao": {
    "AccessTokenMinutos": 15,
    "RefreshTokenDias": 7,
    "OrigemPermitida": ""
  },
  "FontesPublicas": {
    "Pontos": {
      "Ativa": true,
      "UrlDoOverpass": "https://overpass-api.de/api/interpreter",
      "UrlDoNominatim": "https://nominatim.openstreetmap.org/search.php",
      "EmailDeContato": "",
      "TimeoutSegundos": 8,
      "MinutosDeCache": 10,
      "MinutosDeCacheDoMunicipio": 1440,
      "MaximoDePontos": 100
    }
  },
  "LimitesDeTaxa": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Cadastro": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "ConsultaPublica": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
